NEGIN_LOGIN_USERNAME=
NEGIN_LOGIN_PASSWORD_HASH=
OPENAI_API_KEY=
OPENAI_AUTOMATION_API_KEY=
# Resource ceilings are enforced for every external model call. A Redis
# backend must replace the in-process implementation when replicas are added.
NEGIN_MODEL_GLOBAL_CONCURRENCY=8
NEGIN_MODEL_USER_CONCURRENCY=2
NEGIN_MODEL_USER_RPM=12
NEGIN_MODEL_USER_DAILY_BUDGET_UNITS=500000
NEGIN_MODEL_GLOBAL_DAILY_BUDGET_UNITS=20000000
NEGIN_MODEL_MAX_REQUEST_BUDGET_UNITS=100000
# Set to true only when scheduled reports should be allowed to call the model.
AUTOMATION_ENABLED=false
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high
MODEL_ROUTER_ENABLED=true
ROUTER_FAST_MODEL=gpt-5.6-luna
ROUTER_FAST_REASONING_EFFORT=low
ROUTER_STANDARD_MODEL=gpt-5.6-terra
ROUTER_STANDARD_REASONING_EFFORT=medium
# Fast model profile used only for authenticated users with role "فروشنده".
SELLER_OPENAI_MODEL=gpt-5.6-terra
SELLER_OPENAI_REASONING_EFFORT=low
SELLER_OPENAI_MAX_TURNS=6
OPENAI_MAX_TURNS=14
OPENAI_HISTORY_LIMIT=12
ADMIN_OPENAI_MAX_TURNS=40
ADMIN_OPENAI_HISTORY_LIMIT=40
ADMIN_OPENAI_MAX_TOKENS=6000
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
PUSH_NOTIFICATION_URL=/assistant
CHATGPT_GPT_URL=https://chatgpt.com/g/g-6a70a33172dc819198ee3a164b78f509-hwsh-msnw-y-ngyn-pkhsh
