NEGIN_ACTION_API_KEY=
NEGIN_OAUTH_CLIENT_SECRET=
# Exact callback allowlist; add each registered HTTPS callback in full.
NEGIN_OAUTH_REDIRECT_URIS=https://chatgpt.com/aip/g-4554e122eda78292cad88bc29ae5cf3b7cdbb3b2/oauth/callback,https://oauth.openai.com/aip/g-4554e122eda78292cad88bc29ae5cf3b7cdbb3b2/oauth/callback
