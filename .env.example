NEGINAI_ENVIRONMENT=development
NEGIN_ENTERPRISE_DATABASE_URL=
NEGIN_REDIS_URL=
NEGIN_COMMAND_OUTBOX_ENABLED=false
NEGIN_OTEL_EXPORTER_OTLP_ENDPOINT=
ENTITY_SYNC_INTERVAL=300
SCHEMA_SYNC_INTERVAL=3600
