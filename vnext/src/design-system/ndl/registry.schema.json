{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "version", "status", "figmaMapping", "tokenCategories", "components", "patterns"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "figmaMapping": { "const": "FIGMA_MAPPING_PENDING" },
    "semanticAuthority": { "enum": ["NEEDS_VALIDATION", "BLOCKED", "VERIFIED"] },
    "tokenSource": { "type": "string" },
    "tokenCategories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "components": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "patterns": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "source": { "type": "string" },
        "status": { "enum": ["IMPLEMENTED", "PARTIAL", "NEEDS_VALIDATION", "BLOCKED"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
